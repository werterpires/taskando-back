{
  "name": "@taskando/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "npm run build && npm run start:prod",
    "start": "npm run start:prod",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed-user.ts",
    "db:import": "node --env-file-if-exists=.env --import tsx scripts/import-sqlite.ts"
  },
  "dependencies": {
    "nestjs/cli": "^11.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.0",
    "google-auth-library": "^10.3.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "@electric-sql/pglite": "^0.3.10",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3"
  }
}
